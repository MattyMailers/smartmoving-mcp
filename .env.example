# Copy to .env for local shell use only.
# Do not commit real API keys.
SMARTMOVING_API_KEY=replace-with-your-smartmoving-api-key

# Optional. Defaults to https://api-public.smartmoving.com/v1
# SMARTMOVING_BASE_URL=https://api-public.smartmoving.com/v1

# Safety gates. First run should stay read-only.
SMARTMOVING_ALLOW_WRITES=false
SMARTMOVING_ALLOW_DESTRUCTIVE=false
